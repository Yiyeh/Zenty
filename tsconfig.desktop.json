{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "desktop-server",
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "strict": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "server/**/*.ts",
    "src/lib/dashboard.ts",
    "src/lib/gaming.ts",
    "src/lib/library.ts",
    "src/lib/installed-games.ts"
  ]
}
