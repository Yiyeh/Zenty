{
  "name": "personal-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/pdf-assets.mjs",
    "predev": "node scripts/pdf-assets.mjs",
    "prebuild": "node scripts/pdf-assets.mjs",
    "start": "node server/start.ts",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview",
    "desktop:build": "npm run build && tsc -p tsconfig.desktop.json && node scripts/desktop-assets.mjs",
    "desktop": "npm run desktop:build && node scripts/launch-desktop.mjs",
    "desktop:package": "npm run desktop:build && node scripts/package-desktop.mjs",
    "desktop:installer": "npm run desktop:build && electron-builder --config electron-builder.config.mjs --win nsis --x64 --publish never",
    "desktop:publish": "npm run desktop:build && electron-builder --config electron-builder.config.mjs --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "@tailwindcss/vite": "^4.3.2",
    "dompurify": "^3.4.17",
    "jszip": "^3.10.2",
    "lucide-react": "^1.24.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2"
  },
  "overrides": {
    "argparse": "^2.0.1"
  },
  "main": "desktop/main.cjs",
  "description": "Tu espacio personal: productividad, biblioteca, música y gaming.",
  "author": "Yiyeh",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yiyeh/Zenty.git"
  }
}
